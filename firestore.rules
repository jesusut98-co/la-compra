rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cambia los dos correos por el tuyo y el de tu novia (los mismos que crees en Authentication).
    function permitido() {
      return request.auth != null
        && request.auth.token.email in ['tu-correo@ejemplo.com', 'correo-de-tu-novia@ejemplo.com'];
    }
    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
